# Base URL of the Pinance API. Empty = same origin (in development Vite proxies the
# API paths to the backend, see VITE_DEV_API_PROXY).
VITE_API_URL=

# Development server only (npm run dev): where Vite proxies the API paths.
# Defaults to http://localhost:8000 when empty.
VITE_DEV_API_PROXY=

# Optional: link to the experiment tracker, shown on the MLOps tab when set.
VITE_MLFLOW_UI_URL=
